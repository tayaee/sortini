{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "1. Debug CLI (-d sample.ini)",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/bin/sortini.js",
      "args": [
        "-d",
        "sample.ini"
      ],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "2. Debug CLI (-b sample.ini)",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/bin/sortini.js",
      "args": [
        "-b",
        "sample.ini"
      ],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "3. Debug CLI (--no-in-place sample.ini)",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/bin/sortini.js",
      "args": [
        "--no-in-place",
        "sample.ini"
      ],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "4. Debug Unit Tests (npm test)",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/test/test.js",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "5. Debug CLI (Custom Input Prompt...)",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/bin/sortini.js",
      "args": [
        "${input:customCliArgs}"
      ],
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "customCliArgs",
      "type": "promptString",
      "description": "Enter CLI options and file path (e.g., -d my-config.ini)",
      "default": "-d sample.ini"
    }
  ]
}
